# Provider credentials are optional at startup; configure analysis before processing.
# One key per provider. Environment keys override saved keys; there is no key rotation.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Application Settings
SESSION_SECRET_KEY=replace-with-a-long-random-secret
LOG_LEVEL=INFO
PROCESSOR_ENABLED=true
CHECK_INTERVAL_MINUTES=60
BASE_URL=http://localhost:8000
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
MAX_FEED_BYTES=10485760
MAX_DOWNLOAD_BYTES=1572864000
MIN_FREE_SPACE_BYTES=1073741824
FFMPEG_TIMEOUT_SECONDS=7200
ALLOW_PRIVATE_FEEDS=true

# Local faster-whisper configuration (seeds first startup)
WHISPER_MODEL=base
